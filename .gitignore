# Bazel
bazel-*
# Symlink into the output base that the compile-commands extractor creates so
# clangd can resolve the execroot-relative -isystem paths.
/external

# Generated by //:refresh_compile_commands; machine-specific paths.
/compile_commands.json

# Coverage report rendered by `just coverage`.
/coverage-html/

# API docs rendered by `just docs`. Only the generated tree -- docs/examples
# is source, compiled and run by `bazel test //...` and pulled into the docs
# with @snippet.
/docs/html/

# Nix
result
.direnv/

# Editor
.cache/
.clangd/
*.swp
*.swo
*~

# User-local Bazel overrides
user.bazelrc
